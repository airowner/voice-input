{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "声笺",
  "version": "0.1.0",
  "identifier": "local.voice-input.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "声笺 · 语音输入", "width": 920, "height": 800, "minWidth": 560, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "externalBin": ["binaries/voice-asr-worker", "binaries/voice-llm-worker"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libasound2", "libayatana-appindicator3-1", "wl-clipboard", "wtype"] } },
    "macOS": { "minimumSystemVersion": "14.0", "infoPlist": "Info.plist" }
  }
}
